{"number":86,"ayahs":[[1,"وَالسَّمَاۤءِ وَالطَّارِقِۙ","Was-samā'i waṭ-ṭāriq(i)."],[2,"وَمَآ اَدْرٰىكَ مَا الطَّارِقُۙ","Wa mā adrāka maṭ-ṭāriq(u)."],[3,"النَّجْمُ الثَّاقِبُۙ","An-najmuṡ-ṡāqib(u)."],[4,"اِنْ كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌۗ","In kullu nafsil lammā ‘alaihā ḥāfiẓ(un)."],[5,"فَلْيَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَ","Falyanẓuril-insānu mimma khuliq(a)."],[6,"خُلِقَ مِنْ مَّاۤءٍ دَافِقٍۙ","Khuliqa mim mā'in dāfiq(in)."],[7,"يَّخْرُجُ مِنْۢ بَيْنِ الصُّلْبِ وَالتَّرَاۤىِٕبِۗ","Yakhruju mim bainiṣ-ṣulbi wat-tarā'ib(i)."],[8,"اِنَّهٗ عَلٰى رَجْعِهٖ لَقَادِرٌۗ","Innahū ‘alā raj‘ihī laqādir(un)."],[9,"يَوْمَ تُبْلَى السَّرَاۤىِٕرُۙ","Yauma tublas-sarā'ir(u)."],[10,"فَمَا لَهٗ مِنْ قُوَّةٍ وَّلَا نَاصِرٍۗ","Famā lahū min quwwatiw wa lā nāṣir(in)."],[11,"وَالسَّمَاۤءِ ذَاتِ الرَّجْعِۙ","Was-samā'i żātir-raj‘(i)."],[12,"وَالْاَرْضِ ذَاتِ الصَّدْعِۙ","Wal-arḍi żātiṣ-ṣad‘(i)."],[13,"اِنَّهٗ لَقَوْلٌ فَصْلٌۙ","Innahū laqaulun faṣl(un)."],[14,"وَّمَا هُوَ بِالْهَزْلِۗ","Wa mā huwa bil-hazl(i)."],[15,"اِنَّهُمْ يَكِيْدُوْنَ كَيْدًاۙ","Innahum yakīdūna kaidā(n)."],[16,"وَّاَكِيْدُ كَيْدًاۖ","Wa akīdu kaidā(n)."],[17,"فَمَهِّلِ الْكٰفِرِيْنَ اَمْهِلْهُمْ رُوَيْدًا ࣖ","Fa mahhilil-kāfirīna amhilhum ruwaidā(n)."]]}
