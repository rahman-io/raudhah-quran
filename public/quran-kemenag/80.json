{"number":80,"ayahs":[[1,"عَبَسَ وَتَوَلّٰىٓۙ","‘Abasa wa tawallā."],[2,"اَنْ جَاۤءَهُ الْاَعْمٰىۗ","An jā'ahul-a‘mā."],[3,"وَمَا يُدْرِيْكَ لَعَلَّهٗ يَزَّكّٰىٓۙ","Wa mā yudrīka la‘allahū yazzakkā."],[4,"اَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰىۗ","Au yażżakkaru fatanfa‘ahuż-żikrā."],[5,"اَمَّا مَنِ اسْتَغْنٰىۙ","Ammā manistagnā."],[6,"فَاَنْتَ لَهٗ تَصَدّٰىۗ","Fa anta lahū taṣaddā."],[7,"وَمَا عَلَيْكَ اَلَّا يَزَّكّٰىۗ","Wa mā ‘alaika allā yazzakkā."],[8,"وَاَمَّا مَنْ جَاۤءَكَ يَسْعٰىۙ","Wa ammā man jā'aka yas‘ā."],[9,"وَهُوَ يَخْشٰىۙ","Wa huwa yakhsyā."],[10,"فَاَنْتَ عَنْهُ تَلَهّٰىۚ","Fa anta ‘anhu talahhā."],[11,"كَلَّآ اِنَّهَا تَذْكِرَةٌ ۚ","Kallā innahā tażkirah(tun)."],[12,"فَمَنْ شَاۤءَ ذَكَرَهٗ ۘ","Faman syā'a żakarah(ū)."],[13,"فِيْ صُحُفٍ مُّكَرَّمَةٍۙ","Fī ṣuḥufim mukarrmah(tin)."],[14,"مَّرْفُوْعَةٍ مُّطَهَّرَةٍ ۢ ۙ","Marfū‘atim muṭahharah(tin)."],[15,"بِاَيْدِيْ سَفَرَةٍۙ","Bi'aidī safarah(tin)."],[16,"كِرَامٍۢ بَرَرَةٍۗ","Kirāmim bararah(tin)."],[17,"قُتِلَ الْاِنْسَانُ مَآ اَكْفَرَهٗۗ","Qutilal-insānu mā akfarah(ū)."],[18,"مِنْ اَيِّ شَيْءٍ خَلَقَهٗۗ","Min ayyi syai'in khalaqah(ū)."],[19,"مِنْ نُّطْفَةٍۗ خَلَقَهٗ فَقَدَّرَهٗۗ","Min nuṭfah(tin), khalaqahū fa qaddarah(ū)."],[20,"ثُمَّ السَّبِيْلَ يَسَّرَهٗۙ","Ṡummas-sabīla yassarah(ū)."],[21,"ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗۙ","Ṡumma amātahū fa aqbarah(ū)."],[22,"ثُمَّ اِذَا شَاۤءَ اَنْشَرَهٗۗ","Ṡumma iżā syā'a ansyarah(ū)."],[23,"كَلَّا لَمَّا يَقْضِ مَآ اَمَرَهٗۗ","Kallā lammā yaqḍi mā amarah(ū)."],[24,"فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖٓ ۙ","Falyanẓuril-insānu ilā ṭa‘āmih(ī)."],[25,"اَنَّا صَبَبْنَا الْمَاۤءَ صَبًّاۙ","Annā ṣababnal-mā'a ṣabbā(n)."],[26,"ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّاۙ","Ṡumma syaqaqnal-arḍa syaqqā(n)."],[27,"فَاَنْۢبَتْنَا فِيْهَا حَبًّاۙ","Fa'ambatnā fīhā ḥabbā(n)."],[28,"وَّعِنَبًا وَّقَضْبًاۙ","Wa ‘inabaw wa qaḍbā(n)."],[29,"وَّزَيْتُوْنًا وَّنَخْلًاۙ","Wa zaitūnaw wa nakhlā(n)."],[30,"وَّحَدَاۤىِٕقَ غُلْبًا","Wa ḥadā'iqa gulbā(n)."],[31,"وَفَاكِهَةً وَّاَبًّا","Wa fākihataw wa abbā(n)."],[32,"مَتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْۗ","Matā‘al lakum wa li'an‘āmikum."],[33,"فَاِذَا جَاۤءَتِ الصَّاۤخَّةُ ۖ","Fa iżā jā'atiṣ-ṣākhkhah(tu)."],[34,"يَوْمَ يَفِرُّ الْمَرْءُ مِنْ اَخِيْهِۙ","Yauma yafirrul-mar'u min akhīh(i)."],[35,"وَاُمِّهٖ وَاَبِيْهِۙ","Wa ummihī wa abīh(i)."],[36,"وَصَاحِبَتِهٖ وَبَنِيْهِۗ","Wa ṣāḥibatihī wa banīh(i)."],[37,"لِكُلِّ امْرِئٍ مِّنْهُمْ يَوْمَىِٕذٍ شَأْنٌ يُّغْنِيْهِۗ","Likullimri'im minhum yauma'iżin sya'nuy yugnīh(i)."],[38,"وُجُوْهٌ يَّوْمَىِٕذٍ مُّسْفِرَةٌۙ","Wujūhuy yauma'iżim musfirah(tun)."],[39,"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ ۚ","Ḍāḥikatum mustabsyirah(tun)."],[40,"وَوُجُوْهٌ يَّوْمَىِٕذٍ عَلَيْهَا غَبَرَةٌۙ","Wa wujūhuy yauma'iżin ‘alaihā gabarah(tun)."],[41,"تَرْهَقُهَا قَتَرَةٌ ۗ","Tarhaquhā qatarah(tun)."],[42,"اُولٰۤىِٕكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ ࣖ","Ulā'ika humul-kafaratul-fajarah(tu)."]]}
