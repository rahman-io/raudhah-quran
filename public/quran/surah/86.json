an)"],["لَقَوْلٌۭ","laqawlun","perkataan/firman"],["فَصْلٌۭ","faṣlun","terpisah"]]},{"n":14,"g":5945,"ar":"وَمَا هُوَ بِٱلْهَزْلِ","tl":"Wama huwa bilhazl","id":"dan (Alquran) itu bukanlah senda gurauan.","w":[["وَمَا","wamā","dan tidak"],["هُوَ","huwa","ia (Al Qur'an)"],["بِٱلْهَزْلِ","bil-hazli","dengan sia-sia/senda gurau"]]},{"n":15,"g":5946,"ar":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","tl":"Innahum yakeedoona kayda","id":"Sungguh, mereka (orang kafir) merencanakan tipu daya yang jahat,","w":[["إِنَّهُمْ","innahum","sesungguhnya mereka"],["يَكِيدُونَ","yakīdūna","mereka membuat tipu daya"],["كَيْدًۭا","kaydan","tipu daya"]]},{"n":16,"g":5947,"ar":"وَأَكِيدُ كَيْدًا","tl":"Waakeedu kayda","id":"dan Aku pun membuat rencana (tipu daya) yang jitu.","w":[["وَأَكِيدُ","wa-akīdu","dan AKu membuat tipu daya"],["كَيْدًۭا","kaydan","tipu daya"]]},{"n":17,"g":5948,"ar":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","tl":"Famahhili alkafireena amhilhum ruwayda","id":"Karena itu berilah penangguhan kepada orang-orang kafir. Berilah mereka kesempatan untuk sementara waktu.","w":[["فَمَهِّلِ","famahhili","maka beri tangguhlah"],["ٱلْكَـٰفِرِينَ","l-kāfirīna","orang-orang kafir"],["أَمْهِلْهُمْ","amhil'hum","beritangguhlah mereka"],["رُوَيْدًۢا","ruwaydan","sedikit/sebentar"]]}]}
