{"number":86,"nameArabic":"الطارق","nameLatin":"At-Tariq","translationLatin":"Yang Datang di Malam Hari","numberOfAyahs":17,"revelationType":"Makkiyah","bismillahPre":true,"audioBase":"https://cdn.islamic.network/quran/audio/128/ar.alafasy","ayahs":[{"n":1,"g":5932,"ar":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","tl":"Wassama-i wattariq","id":"Demi langit dan yang datang pada malam hari.","w":[["وَٱلسَّمَآءِ","wal-samāi","dan langit"],["وَٱلطَّارِقِ","wal-ṭāriqi","dan yang datang di malam hari"]]},{"n":2,"g":5933,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","tl":"Wama adraka ma attariq","id":"Dan tahukah kamu apakah yang datang pada malam hari itu?","w":[["وَمَآ","wamā","dan apa"],["أَدْرَىٰكَ","adrāka","kamu tahu"],["مَا","mā","apa"],["ٱلطَّارِقُ","l-ṭāriqu","yang datang dimalam hari"]]},{"n":3,"g":5934,"ar":"ٱلنَّجْمُ ٱلثَّاقِبُ","tl":"Annajmu aththaqib","id":"(Yaitu) bintang yang bersinar tajam,","w":[["ٱلنَّجْمُ","al-najmu","bintang"],["ٱلثَّاقِبُ","l-thāqibu","cemerlang/menembus"]]},{"n":4,"g":5935,"ar":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","tl":"In kullu nafsin lamma AAalayha hafith","id":"setiap orang pasti ada penjaganya.","w":[["إِن","in","tidak"],["كُلُّ","kullu","setiap"],["نَفْسٍۢ","nafsin","jiwa/diri"],["لَّمَّا","lammā","melainkan"],["عَلَيْهَا","ʿalayhā","atasnya"],["حَافِظٌۭ","ḥāfiẓun","penjaga"]]},{"n":5,"g":5936,"ar":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","tl":"Falyanthuri al-insanumimma khuliq","id":"Maka hendaklah manusia memperhatikan dari apa dia diciptakan.","w":[["فَلْيَنظُرِ","falyanẓuri","maka hendaklah memperhatikan"],["ٱلْإِنسَـٰنُ","l-insānu","manusia"],["مِمَّ","mimma","dari apa"],["خُلِقَ","khuliqa","ia diciptakan"]]},{"n":6,"g":5937,"ar":"خُلِقَ مِن مَّآءٍ دَافِقٍ","tl":"Khuliqa min ma-in dafiq","id":"Dia diciptakan dari air (mani) yang terpancar,","w":[["خُلِقَ","khuliqa","ia diciptakan"],["مِن","min","dari"],["مَّآءٍۢ","māin","air"],["دَافِقٍۢ","dāfiqin","terpancar"]]},{"n":7,"g":5938,"ar":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","