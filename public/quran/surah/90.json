{"number":90,"nameArabic":"البلد","nameLatin":"Al-Balad","translationLatin":"Negeri","numberOfAyahs":20,"revelationType":"Makkiyah","bismillahPre":true,"audioBase":"https://cdn.islamic.network/quran/audio/128/ar.alafasy","ayahs":[{"n":1,"g":6024,"ar":"لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ","tl":"La oqsimu bihatha albalad","id":"Aku bersumpah dengan negeri ini (Mekkah),","w":[["لَآ","lā","sungguh"],["أُقْسِمُ","uq'simu","Aku bersumpah"],["بِهَـٰذَا","bihādhā","dengan ini"],["ٱلْبَلَدِ","l-baladi","negeri"]]},{"n":2,"g":6025,"ar":"وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ","tl":"Waanta hillun bihatha albalad","id":"dan engkau (Muhammad), bertempat di negeri (Mekkah) ini,","w":[["وَأَنتَ","wa-anta","dan kamu"],["حِلٌّۢ","ḥillun","halal/bertempat"],["بِهَـٰذَا","bihādhā","dengan ini"],["ٱلْبَلَدِ","l-baladi","negeri"]]},{"n":3,"g":6026,"ar":"وَوَالِدٍ وَمَا وَلَدَ","tl":"Wawalidin wama walad","id":"dan demi (pertalian) bapak dan anaknya.","w":[["وَوَالِدٍۢ","wawālidin","demi bapak"],["وَمَا","wamā","dan apa"],["وَلَدَ","walada","ia lahirkan (anak)"]]},{"n":4,"g":6027,"ar":"لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ","tl":"Laqad khalaqna al-insana feekabad","id":"Sungguh, Kami telah menciptakan manusia berada dalam susah payah.","w":[["لَقَدْ","laqad","sesungguhnya"],["خَلَقْنَا","khalaqnā","Kami telah menciptakan"],["ٱلْإِنسَـٰنَ","l-insāna","manusia"],["فِى","fī","dalam"],["كَبَدٍ","kabadin","susah payah"]]},{"n":5,"g":6028,"ar":"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ","tl":"Ayahsabu an lan yaqdira AAalayhi ahad","id":"Apakah dia (manusia) itu mengira bahwa tidak ada sesuatu pun yang berkuasa atasnya?","w":[["أَيَحْسَبُ","ayaḥsabu","apakah (manusia) menyangka"],["أَن","an","bahwa"],["لَّن","lan","tidak"],["يَقْدِرَ","yaqdira","berkuasa"],["عَلَيْهِ","ʿalayhi","atasnya"],["أَحَدٌۭ","aḥadun","seseorang/satu"]]},{"n":6,"g":6029,"ar":"يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا","tl":"Yaqoolu ahlaktu malan lubada","id":"Dia mengatakan, \"Aku telah menghabiskan harta yang banyak.\"","w":[