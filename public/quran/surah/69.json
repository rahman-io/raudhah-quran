{"number":69,"nameArabic":"الحاقة","nameLatin":"Al-Haqqah","translationLatin":"Kenyataan (Hari Kiamat)","numberOfAyahs":52,"revelationType":"Makkiyah","bismillahPre":true,"audioBase":"https://cdn.islamic.network/quran/audio/128/ar.alafasy","ayahs":[{"n":1,"g":5324,"ar":"ٱلْحَآقَّةُ","tl":"Alhaqqa","id":"Hari kiamat,","w":[["ٱلْحَآقَّةُ","al-ḥāqatu","keadaan yang sebenarnya"]]},{"n":2,"g":5325,"ar":"مَا ٱلْحَآقَّةُ","tl":"Ma alhaqqa","id":"apakah hari Kiamat itu?","w":[["مَا","mā","apakah"],["ٱلْحَآقَّةُ","l-ḥāqatu","keadaan yang sebenarnya"]]},{"n":3,"g":5326,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","tl":"Wama adraka ma alhaqqa","id":"Dan tahukah kamu apakah hari Kiamat itu?","w":[["وَمَآ","wamā","dan apakah"],["أَدْرَىٰكَ","adrāka","kamu mengetahui"],["مَا","mā","apa"],["ٱلْحَآقَّةُ","l-ḥāqatu","keadaan yang sebenarnya"]]},{"n":4,"g":5327,"ar":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","tl":"Kaththabat thamoodu waAAadun bilqariAAa","id":"Kaum Samud, dan 'Ād telah mendustakan hari Kiamat.","w":[["كَذَّبَتْ","kadhabat","telah mendustakan"],["ثَمُودُ","thamūdu","kaum Tsamud"],["وَعَادٌۢ","waʿādun","dan kaum 'Ad"],["بِٱلْقَارِعَةِ","bil-qāriʿati","dengan yang mengejutkan/hari kiamat"]]},{"n":5,"g":5328,"ar":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ","tl":"Faamma thamoodu faohlikoo bittaghiya","id":"Maka adapun kaum Samud, mereka telah dibinasakan dengan suara yang sangat keras,","w":[["فَأَمَّا","fa-ammā","maka adapun"],["ثَمُودُ","thamūdu","kaum Tsamud"],["فَأُهْلِكُوا۟","fa-uh'likū","maka mereka dibinasakan"],["بِٱلطَّاغِيَةِ","bil-ṭāghiyati","dengan teriakan/kejadian luar biasa"]]},{"n":6,"g":5329,"ar":"وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ","tl":"Waamma AAadun faohlikoo bireehinsarsarin AAatiya","id":"sedangkan kaum 'Ād, mereka telah dibinasakan dengan angin topan yang sangat dingin,","w":[["وَأَمَّا","wa-ammā","dan adapun"],["عَادٌۭ","ʿādun","kaum 'Ad"],["فَأُهْلِكُوا۟","fa-uh'likū","maka mereka dibinasakan"],["بِرِيحٍۢ","birīḥin","d